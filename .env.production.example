# Production Environment Configuration
# Copy this file to .env.production and update with your actual production values

# Database - Production PostgreSQL
DATABASE_URL="postgresql://username:password@host:port/database"

# JWT - Use strong, unique secrets in production
JWT_SECRET="your-strong-jwt-secret-at-least-32-characters-long"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="your-strong-refresh-jwt-secret-at-least-32-characters-long"
JWT_REFRESH_EXPIRES_IN="30d"

# Server
PORT=5000
NODE_ENV="production"

# CORS - Production Frontend URLs
FRONTEND_URL="https://your-frontend-domain.com"
STUDENT_PORTAL_URL="https://your-student-portal-domain.com"
APPLICANT_PORTAL_URL="https://your-applicant-portal-domain.com"

# Payment Gateways - Production Keys
PAYSTACK_SECRET_KEY="sk_live_your_production_paystack_secret_key"
PAYSTACK_PUBLIC_KEY="pk_live_your_production_paystack_public_key"

# Flutterwave Production Keys
FLUTTERWAVE_PUBLIC_KEY="FLWPUBK-your_production_public_key"
FLUTTERWAVE_SECRET_KEY="FLWSECK-your_production_secret_key"
FLUTTERWAVE_ENCRYPTION_KEY="your_production_encryption_key"
FLUTTERWAVE_SECRET_HASH="your_production_webhook_secret_hash"

# Email Configuration - Production SMTP
SMTP_HOST="smtp.your-email-provider.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-production-email@domain.com"
SMTP_PASSWORD="your-production-email-password"
EMAIL_FROM="Your App Name <noreply@yourdomain.com>"

# File Upload
UPLOAD_DIR="uploads"
MAX_FILE_SIZE=5242880

# Application URLs - Production
APP_URL="https://your-api-domain.com"
STUDENT_PORTAL_URL="https://your-student-portal-domain.com"
APPLICANT_PORTAL_URL="https://your-applicant-portal-domain.com"